{
  "name": "@petflow/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schemas de validacao, tipos e matriz de permissoes compartilhados entre API e Web",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
