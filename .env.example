# =============================================================================
# PetFlow - variaveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env com valores reais.
# =============================================================================

# -----------------------------------------------------------------------------
# APLICACAO
# -----------------------------------------------------------------------------
NODE_ENV=development
# Porta da API
PORT=3333
# URL publica do frontend (usada em CORS -- so essa origem pode chamar a API
# com credenciais -- e nos links de reset de senha, emails)
APP_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# FRONTEND (Vite -- so variaveis com prefixo VITE_ chegam ao navegador; NUNCA
# colocar segredo aqui, e visivel no bundle publicado)
# -----------------------------------------------------------------------------
# URL publica da API, sem barra final (ex.: https://api.petflow.app).
# Vazio em desenvolvimento: o proxy do Vite (apps/web/vite.config.ts)
# encaminha /api/* para a API local na mesma origem, sem precisar disso.
# Preencher apenas quando a API estiver hospedada num dominio separado do
# frontend (arquitetura de producao).
VITE_API_URL=

# -----------------------------------------------------------------------------
# BANCO DE DADOS
# -----------------------------------------------------------------------------
# PostgreSQL. Em producao e OBRIGATORIO.
# Use um usuario SEM atributos SUPERUSER/BYPASSRLS: RLS nao se aplica a superusuarios.
DATABASE_URL=postgres://petflow:petflow@localhost:5432/petflow

# Driver do banco: "postgres" (producao/dev com PG real) ou "pglite" (dev/teste sem PG instalado).
# pglite = PostgreSQL real compilado para WASM, roda embutido no processo Node.
DB_DRIVER=pglite
# Diretorio de dados quando DB_DRIVER=pglite. Use "memory://" para banco efemero.
PGLITE_DATA_DIR=./.data/pglite
# Tamanho maximo do pool (driver postgres)
DB_POOL_MAX=10

# -----------------------------------------------------------------------------
# AUTENTICACAO / SEGURANCA
# -----------------------------------------------------------------------------
# Segredo para assinatura de cookies. Minimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=troque-este-valor-por-um-segredo-aleatorio-de-48-bytes
# Duracao da sessao em dias
SESSION_TTL_DAYS=7
# Duracao do token de recuperacao de senha em minutos
PASSWORD_RESET_TTL_MINUTES=60
# Nome do cookie de sessao
SESSION_COOKIE_NAME=petflow_session
# Dominio do cookie (deixe vazio em desenvolvimento)
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# -----------------------------------------------------------------------------
# EMAIL (recuperacao de senha, convites)
# -----------------------------------------------------------------------------
# Provider: "console" (imprime no log do servidor, padrao em dev) ou "smtp".
# Enquanto for "console" NENHUM email e realmente enviado.
MAIL_PROVIDER=console
MAIL_FROM=nao-responda@petflow.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# WHATSAPP
# -----------------------------------------------------------------------------
# Cada pet shop conecta o PROPRIO WhatsApp Business (plataforma oficial da
# Meta) em Configuracoes > WhatsApp. Nao ha numero/token global: o token de
# cada pet shop fica criptografado no banco com a chave abaixo.
# Sem conexao, as mensagens ficam registradas e saem pelo link wa.me.
#
# Chave de 32 bytes (base64 ou hex) -- gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NAO troque depois de ter pet shops conectados (os tokens nao decifram mais).
WHATSAPP_TOKEN_ENCRYPTION_KEY=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
# App do Petflow na Meta (Tech Provider) para o Embedded Signup (botao
# "Conectar WhatsApp Business"). Sem estes, so a conexao manual (avancado).
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Webhook de status (entregue/lida): URL publica
#   https://<api>/api/webhooks/whatsapp
# VERIFY_TOKEN: valor livre que voce tambem informa no painel da Meta.
# APP_SECRET: "Chave secreta do app" (Meta for Developers > Configuracoes >
# Basico). Usada para validar a assinatura X-Hub-Signature-256.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# -----------------------------------------------------------------------------
# ASSISTENTE (IA) -- central do Petflow, somente no servidor
# -----------------------------------------------------------------------------
# A chave e do SaaS (configure no Railway), nunca do pet shop e NUNCA no
# frontend, no Git ou em logs. O modelo so ESCOLHE qual consulta rodar; os
# numeros sempre vem do banco do pet shop logado.
#   AI_PROVIDER=none    -> so as perguntas prontas (sem IA externa)
#   AI_PROVIDER=openai  -> pergunta livre via OpenAI (SDK oficial)
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Alternativa (Anthropic), mantida por compatibilidade:
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# -----------------------------------------------------------------------------
# BILLING / CAKTO -- ver CAKTO.md para o estado completo da integracao
# -----------------------------------------------------------------------------
# Link do checkout hospedado do plano PRO na Cakto. Estatico (nao gerado por
# API): o botao "Assinar PRO" redireciona direto para ele.
CAKTO_PRO_CHECKOUT_URL=https://pay.cakto.com.br/upofina_1130180

# AGUARDANDO CONFIGURACAO DO PROJETO: mecanismo real de autenticacao do
# webhook da Cakto (header de assinatura? token na URL?) ainda nao confirmado.
# Sem isso preenchido, POST /api/webhooks/cakto responde 503 e nao aceita
# nenhum evento -- ver CAKTO.md.
CAKTO_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# OBSERVABILIDADE
# -----------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
