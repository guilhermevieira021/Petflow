# =============================================================================
# PetFlow - variaveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env com valores reais.
# =============================================================================

# -----------------------------------------------------------------------------
# APLICACAO
# -----------------------------------------------------------------------------
NODE_ENV=development
# Porta da API
PORT=3333
# URL publica do frontend (usada em CORS, links de reset de senha, emails)
APP_URL=http://localhost:5173
# URL publica da API (usada pelo frontend em build de producao)
API_URL=http://localhost:3333

# -----------------------------------------------------------------------------
# BANCO DE DADOS
# -----------------------------------------------------------------------------
# PostgreSQL. Em producao e OBRIGATORIO.
# Use um usuario SEM atributos SUPERUSER/BYPASSRLS: RLS nao se aplica a superusuarios.
DATABASE_URL=postgres://petflow:petflow@localhost:5432/petflow

# Driver do banco: "postgres" (producao/dev com PG real) ou "pglite" (dev/teste sem PG instalado).
# pglite = PostgreSQL real compilado para WASM, roda embutido no processo Node.
DB_DRIVER=pglite
# Diretorio de dados quando DB_DRIVER=pglite. Use "memory://" para banco efemero.
PGLITE_DATA_DIR=./.data/pglite
# Tamanho maximo do pool (driver postgres)
DB_POOL_MAX=10

# -----------------------------------------------------------------------------
# AUTENTICACAO / SEGURANCA
# -----------------------------------------------------------------------------
# Segredo para assinatura de cookies. Minimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=troque-este-valor-por-um-segredo-aleatorio-de-48-bytes
# Duracao da sessao em dias
SESSION_TTL_DAYS=7
# Duracao do token de recuperacao de senha em minutos
PASSWORD_RESET_TTL_MINUTES=60
# Nome do cookie de sessao
SESSION_COOKIE_NAME=petflow_session
# Dominio do cookie (deixe vazio em desenvolvimento)
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# -----------------------------------------------------------------------------
# EMAIL (recuperacao de senha, convites)
# -----------------------------------------------------------------------------
# Provider: "console" (imprime no log do servidor, padrao em dev) ou "smtp".
# Enquanto for "console" NENHUM email e realmente enviado.
MAIL_PROVIDER=console
MAIL_FROM=nao-responda@petflow.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# WHATSAPP
# -----------------------------------------------------------------------------
# Provider: "link" (gera links wa.me, nenhuma API e chamada) ou "cloud_api".
# Enquanto for "link" NENHUMA mensagem e enviada automaticamente.
WHATSAPP_PROVIDER=link
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# -----------------------------------------------------------------------------
# BILLING / CAKTO -- ver CAKTO.md para o estado completo da integracao
# -----------------------------------------------------------------------------
# Link do checkout hospedado do plano PRO na Cakto. Estatico (nao gerado por
# API): o botao "Assinar PRO" redireciona direto para ele.
CAKTO_PRO_CHECKOUT_URL=https://pay.cakto.com.br/upofina_1130180

# AGUARDANDO CONFIGURACAO DO PROJETO: mecanismo real de autenticacao do
# webhook da Cakto (header de assinatura? token na URL?) ainda nao confirmado.
# Sem isso preenchido, POST /api/webhooks/cakto responde 503 e nao aceita
# nenhum evento -- ver CAKTO.md.
CAKTO_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# OBSERVABILIDADE
# -----------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
